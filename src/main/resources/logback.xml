<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- LOG_HOME: 定义日志文件存放的文件夹路径 -->
    <property name="LOG_HOME" value="./logs" />
    <!-- LOG_PATTERN: 定义日志输出格式 -->
    <!-- %d 时间, %thread 线程名, %-5level 日志级别(左对齐), %logger{36} 类名(最长36字符), %msg 消息, %n 换行 -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n" />

    <!-- ==================== Appender 配置区 ==================== -->
    <!-- Appender: 定义日志输出的目标(控制台/文件)和方式 -->

    <!-- CONSOLE: 输出到控制台 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- FILE: 输出到文件，支持按日期和大小自动分割 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 当前日志文件路径 -->
        <file>${LOG_HOME}/application.log</file>
        <!-- 滚动策略: 满足任一个条件就创建新文件 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 归档文件名格式: application-2024-01-01.1.log -->
            <fileNamePattern>${LOG_HOME}/application-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- maxHistory: 保留最近7天的日志文件，超出的自动删除 -->
            <maxHistory>7</maxHistory>
            <!-- 按文件大小分割: 单个文件超过50MB时创建新文件 -->
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>50MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ERROR_FILE: 单独记录ERROR级别日志，便于排查问题 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/error.log</file>
        <!-- LevelFilter: 只记录ERROR级别的日志 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <!-- 错误日志保留30天，方便追溯 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/error-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ==================== Logger 配置区 ==================== -->
    <!-- Logger: 控制哪些包的日志输出及输出级别 -->
    <!-- 级别从低到高: TRACE < DEBUG < INFO < WARN < ERROR -->
    <!-- 级别越高，记录越少。生产环境通常用INFO，开发环境用DEBUG -->

    <!-- Spring框架: 设置为WARN减少无关日志 -->
    <logger name="org.springframework" level="WARN" />
    <!-- MyBatis: 设置为INFO可查看SQL语句 -->
    <logger name="org.mybatis" level="INFO" />
    <!-- Hibernate: 设置为WARN减少SQL细节日志 -->
    <logger name="org.hibernate" level="WARN" />

    <!-- ==================== Root Logger ==================== -->
    <!-- root logger: 所有未单独配置的包都使用这个 -->
    <!-- level: 全局日志级别，低于此级别的不会输出 -->
    <root level="INFO">
        <!-- 引用上面定义的3个appender，日志会同时输出到这三个地方 -->
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
    </root>
</configuration>
