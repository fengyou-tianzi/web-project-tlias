<?xml version="1.0" encoding="UTF-8"?>
<!--
  logback.xml 配置文件说明：
  - 此文件用于配置 slf4j 的实现框架 logback 的日志行为
  - slf4j 是日志门面，logback 是具体的日志实现
  - 配置文件加载顺序：logback-test.xml > logback.groovy > logback.xml
  - 如需启用调试模式，可添加 scan="true" scanPeriod="60 seconds" 属性
-->
<configuration scan="true" scanPeriod="60 seconds" debug="false">

    <!--
        ==========================================
        第1部分：定义变量（Properties）
        ==========================================
        通过 <property> 标签定义可复用的变量
        可以使用 ${变量名} 引用
    -->

    <!-- 定义日志文件的存放路径，默认为当前项目根目录下的 logs 文件夹 -->
    <property name="LOG_HOME" value="./logs" />

    <!-- 定义日志文件的命名格式 -->
    <property name="LOG_FILE_NAME" value="application" />

    <!-- 定义控制台输出格式 -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n" />

    <!-- 定义文件输出格式（包含更多详细信息） -->
    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n" />

    <!--
        ==========================================
        第2部分：定义 Appenders（输出目的地）
        ==========================================
        Appender 负责将日志事件输出到指定目标
        常见类型：ConsoleAppender（控制台）、FileAppender（文件）、RollingFileAppender（滚动文件）
    -->

    <!-- 2.1 控制台输出配置 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- 设置日志输出格式 -->
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <!-- 设置字符编码 -->
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 2.2 滚动文件输出配置（推荐用于生产环境） -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 日志文件路径 -->
        <file>${LOG_HOME}/${LOG_FILE_NAME}.log</file>

        <!-- 滚动策略配置 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 按时间滚动：每天生成一个新文件 -->
            <fileNamePattern>${LOG_HOME}/${LOG_FILE_NAME}-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- 保留的最大历史天数（超过此天数的旧文件会被自动删除） -->
            <maxHistory>30</maxHistory>
            <!-- 当总文件大小超过此限制时，触发删除旧文件 -->
            <totalSizeCap>10GB</totalSizeCap>
            <!-- 时间滚动周期，这里设置为每天 -->
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <!-- 单个文件最大 size，超过则创建新文件 -->
                <maxFileSize>100MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>

        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 2.3 错误日志单独输出（只记录 ERROR 级别） -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/error.log</file>
        <!-- 只记录 ERROR 级别的日志 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <!-- 匹配到 ERROR 级别时的处理方式：ACCEPT 表示接受 -->
            <onMatch>ACCEPT</onMatch>
            <!-- 未匹配到时的处理方式：DENY 表示拒绝 -->
            <onMismatch>DENY</onMismatch>
        </filter>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/error-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 2.4 异步输出配置（提升性能，推荐在高并发场景使用） -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <!-- 指定要异步化的 appender -->
        <appender-ref ref="FILE"/>
        <!-- 队列容量，默认为 256 -->
        <queueSize>512</queueSize>
        <!-- 丢弃日志的阈值，默认 20%，当队列剩余容量低于此值时开始丢弃日志 -->
        <discardingThreshold>0</discardingThreshold>
        <!-- 是否包含调用者信息（会影响性能，建议关闭） -->
        <includeCallerData>false</includeCallerData>
        <!-- 等待时间，超过此时间则丢弃日志 -->
        <neverBlock>true</neverBlock>
    </appender>

    <!--
        ==========================================
        第3部分：定义 Loggers（日志记录器）
        ==========================================
        Logger 用来指定日志的输出级别和生效的 Appender
        级别由低到高：TRACE < DEBUG < INFO < WARN < ERROR
        如果未指定级别，默认继承 root logger 的级别
    -->

    <!-- 3.1 根日志记录器（所有未指定 logger 的日志都会使用） -->
    <root level="INFO">
        <!-- 引用之前定义的 appender -->
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
    </root>

    <!-- 3.2 特定包的日志配置（示例：Spring Framework） -->
    <logger name="org.springframework" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>

    <!-- 3.3 特定包的日志配置（示例：MyBatis） -->
    <logger name="org.mybatis" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>

    <!-- 3.4 特定包的日志配置（示例：Hibernate） -->
    <logger name="org.hibernate" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>

    <!-- 3.5 特定包的日志配置（示例：Apache Commons） -->
    <logger name="org.apache.commons" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>

    <!-- 3.6 特定包的日志配置（示例：应用业务代码） -->
    <logger name="com.example.myapp" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>

    <!-- 3.7 SQL 日志输出配置 -->
    <logger name="com.example.myapp.mapper" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>

    <!--
        ==========================================
        第4部分：Spring Boot 特定配置（可选）
        ==========================================
        如果你使用的是 Spring Boot，可以使用 Spring Boot 提供的一些特殊配置
        如需启用，请取消注释以下内容
    -->

    <!-- Spring Boot 的 logback 配置 -->
    <!--
    <springProfile name="dev">
        <logger name="com.example.myapp" level="DEBUG"/>
    </springProfile>

    <springProfile name="prod">
        <logger name="com.example.myapp" level="WARN"/>
    </springProfile>
    -->

</configuration>
